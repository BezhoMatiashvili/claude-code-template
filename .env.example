# Copy to .env and fill in only what this project uses. Never commit .env.
# MCP servers read these from the shell environment, so export them before
# starting Claude Code (e.g. `set -a; source .env; set +a`, or use direnv).

# Supabase MCP (mcp/optional-servers.json -> supabase / supabase-staging)
SUPABASE_ACCESS_TOKEN=
SUPABASE_PROJECT_REF=
SUPABASE_STAGING_PROJECT_REF=

# DigitalOcean MCP (mcp/optional-servers.json -> digitalocean)
DIGITALOCEAN_API_TOKEN=
